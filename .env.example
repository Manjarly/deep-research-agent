# ==========================================
# Autonomous Deep Research Agent Configuration
# ==========================================

# Google Gemini API Key (Required for Gemini)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Model Settings
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash
MODEL_TEMPERATURE=0.2

# Optional Search API (DuckDuckGo is used by default for free!)
# If you have a Tavily key, enter it here for higher fidelity web search:
# https://tavily.com
TAVILY_API_KEY=

# Research Agent Parameters
MAX_RESEARCH_LOOPS=2
MAX_SEARCH_RESULTS_PER_QUERY=4
MAX_SCRAPE_CHARS=6000
